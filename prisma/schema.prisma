// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Activity {
  id            String   @id @default(cuid())
  source        String   @default("strava")
  sourceId      String
  name          String
  distance      Float
  movingTime    Int
  elapsedTime   Int
  totalElevGain Float
  startDate     DateTime
  type          String
  gpsData       Json?

  difficulty  String?
  conditions  String?
  weather     String?
  notes       String?
  rating      Int?
  companions  String?
  gear        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, sourceId])
}
